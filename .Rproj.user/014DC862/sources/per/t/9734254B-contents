#### Time Series

```{r}
EC_dd_avgs <- ggplot(dd_dayavg_all, aes(x = date)) +
  geom_smooth(
    aes(y = dd_dayavg_EC),
    method = "loess",
    linewidth = 0.5,
    alpha = 0.8
  ) +
  labs(
    x = "Date",                            
    y = "Conductivity mS",
    title = "Average Yearly Conductivity of Dawn/Dusk/Dawn Sampled Ponds in San Joaquin Marsh"
  ) +
  scale_x_date(
    date_labels = "%Y",            
    date_breaks = "1 year",
    expand = c(0, 0)
  ) +
  theme_bw() +
  theme(
    legend.position = "right",
    plot.title = element_text(hjust = 0.5),
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    axis.title.y = element_text(size = 10.5),
    text = element_text(family = "Helvetica")
  ) +
  facet_wrap(~sampling_location)
      #this does not look right ??? looking at salinity next
plot(EC_dd_avgs)
```

