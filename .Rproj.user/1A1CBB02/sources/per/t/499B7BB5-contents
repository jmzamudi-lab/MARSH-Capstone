### Germination Rate

```{r}
#treatement is that DT AC OA thing
#cleaning germination rate data: each tag once?, last time only?, exclude NRs only Acorns NOT OCT 2025
unloadNamespace("plyr")

#created a data set for germination rate and cleaned data: selected only necessary columns, dropped all values of oak type labeled as NR because we are only looking at acorns and seedlings, looking at only plants that actually grew

germ_rate_data <-
  oak_data_CLEAN |> 
    select(Date, Tag_Num, Acorn_Num, Oak_type, Treatment, OA_microclimate, Seedling_Ht_cm, Num_germinated) |> 
  filter( Oak_type != "NR") |> 
  filter(Seedling_Ht_cm > 0) |> 
  filter( Oak_type != "S")

#remove NA from data????

  
#organizing dates to get only the latest data entry for each tag number and acorn entry

germ_rate_data_latest <-
  germ_rate_data|>
  group_by(Tag_Num, Acorn_Num) |> 
  arrange(desc(Date)) |> 
  slice(1) |> 
  ungroup()

#calculating the germination rate with the latest entries
germination_rate <-
  germ_rate_data_latest |> 
  group_by(Tag_Num, Acorn_Num) |>
  mutate(germ_rate = (Num_germinated/3)*100)
  
```

### Germination Rate for Acorns per microclimate

```{r}
#germination rate per microclimate

germ_OA_microclimate <-
germination_rate |> 
  group_by(OA_microclimate) |> 
  summarise(n=n(), germ_microclimate= mean(germ_rate)) |> 
  filter(!is.na(germ_microclimate))

```

### Acorn Germination Rate by Microclimate

```{r}

microclimate <- 
  ggplot(germ_OA_microclimate) + 
  aes(x = OA_microclimate, y = germ_microclimate,fill= OA_microclimate) + 
  labs(title= "Acorn Germination Rate by Microclimate", x= "Microclimate", y= "Average Germination Rate %" )+
  scale_fill_discrete(
    labels = c("CN"="Control", "TH"= "Thatch Removed", "TI"= "Thatch and Invasive Species Removed"))+
  geom_col()

plot(microclimate)
```

