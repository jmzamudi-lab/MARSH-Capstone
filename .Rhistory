#Adding a 'season' column based on month
dd_seasonalavg_all <-
dd_dayavg_all |>
mutate(
month = month(date),
season = case_when(
month %in% c(12, 1, 2) ~ "Winter",
month %in% c(3, 4, 5)  ~ "Spring",
month %in% c(6, 7, 8)  ~ "Summer",
month %in% c(9, 10, 11) ~ "Fall"
),
year = year(date)
)
View(dd_seasonalavg_all)
#Adding a 'season' column based on month
dd_seasons <-
dd_dayavg_all |>
mutate(
month = month(date),
season = case_when(
month %in% c(12, 1, 2) ~ "Winter",
month %in% c(3, 4, 5)  ~ "Spring",
month %in% c(6, 7, 8)  ~ "Summer",
month %in% c(9, 10, 11) ~ "Fall"
),
year = year(date)
)
View(dd_seasons)
#Calculate the average per season
dd_seasonalavg_all <- dd_seasons %>%
group_by(year, season) %>%
summarise(
dd_savg_EC = mean(dd_dayavg_EC, na.rm = TRUE),
dd_savg_TDS = mean(dd_dayavg_TDS, na.rm = TRUE),
dd_savg_temp = mean(dd_dayavg_temp, na.rm = TRUE),
dd_savg_salinity = mean(dd_dayavg_salinity, na.rm = TRUE),
dd_savg_pH = mean(dd_dayavg_pH, na.rm = TRUE),
.groups = "drop")
View(dd_seasonalavg_all)
#Calculate the average per season
dd_seasonalavg_all <- dd_seasons %>%
group_by(sampling_location,year, season) %>%
summarise(
dd_savg_EC = mean(dd_dayavg_EC, na.rm = TRUE),
dd_savg_TDS = mean(dd_dayavg_TDS, na.rm = TRUE),
dd_savg_temp = mean(dd_dayavg_temp, na.rm = TRUE),
dd_savg_salinity = mean(dd_dayavg_salinity, na.rm = TRUE),
dd_savg_pH = mean(dd_dayavg_pH, na.rm = TRUE),
.groups = "drop")
# Combine season and year with a space separator
dd_seasonalavg_all <-
dd_seasonalavg_all |>
unite(col = "season_year", season, year, sep = " ")
# Plot scatter points and a line graph faceted by year
ggplot(dd_seasonalavg_all, aes(x = season_year, y = dd_savg_EC)) +
geom_point(color = "blue", alpha = 0.6) +   # Adds the scatter plot
geom_line(color = "darkred", size = 1) +     # Adds the line graph
labs(
title = "Marsh EC over time",
x = "Season and Year",
y = "EC"
) +
theme_minimal()+
facet_wrap(~sampling_location)
