notes = "anything that might affect water quality-inverts, algae, temp, weather, etc"
)
#fixing the time column since importing the file added a random date into the time column, making it time only
mwq_data_2020_current$time <- format(mwq_data_2020_current$time, format = "%H:%M:%S")
view(mwq_data_2020_current)
#fixing the NA columns more
mwq_data_2020_current <- mwq_data_2020_current |>
mutate(across(c(staff_gauge_ft, surface_temp,EC_surface,TDS_surface,pH, salinity_surface, tide), ~na_if(., "-")))
#gotta have NS be read as NA
mwq_data_2020_current <- mwq_data_2020_current |>
mutate(pH = na_if(pH, "NS"),
surface_temp = na_if(surface_temp, "NS"),
EC_surface = na_if(EC_surface, "NS"),
TDS_surface = na_if(TDS_surface, "NS"),
salinity_surface = na_if(salinity_surface, "NS"))
# Replace multiple different symbols/numbers with a single number
# EXAMPLE: df$col_name[df$col_name %in% c(">", "<", "?", "N/A", -99)] <- 0
#STAFF GAUGE COLUMNS
# Replace a specific old value (number or symbol stored as character/factor) with a new number:
#changing 2.5 n/a to just 2.5
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft == "2.5 n/a"] <- 2.5
#change >4 and 4+ to 4.1???? yes or nah, must ask Julie?
#changing >4 to 4.1
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft == ">4"] <- 4.1
#changing 4+ to 4.1
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft == "4+"] <- 4.1
#fix mid to low
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft == "mid to low"] <- 3
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft == "low"] <- 1
#replacing the 'too dark's and blanks w/ NAs, keeping mid and low?
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft %in% c("too dark", "blank", "N/A")] <- NA
#replacing the too dark to tell w/ NA
mwq_data_2020_current$staff_gauge_ft[mwq_data_2020_current$staff_gauge_ft == '"too dark to tell"'] <- NA
#SAMPLING LOCATION
#need to drop row that says blah blah new YSI meter
mwq_data_2020_current <- mwq_data_2020_current |>
filter(sampling_location != "All samples taken below this done with new YSI Meter")
#we be keeping pH, its perfect, im perfect, dont need to change it
#SURFACE TEMP, amazing, perfect
#ELECTRIC CONDUCTIVITY (EC)
#fixing the cells in μs/cm to mS, its a simple conversion so no biggie
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "4765 μs/cm"] <- 4.765
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "11767 μs/cm"] <- 11.767
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "29448 μs/cm"] <- 29.448
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "18191 μs/cm"] <- 18.191
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "1873 μs/cm"] <- 1.873
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "4378 μs/cm"] <- 4.378
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "7353 μs/cm"] <- 7.353
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "652 μs/cm"] <- 0.652
mwq_data_2020_current$EC_surface[mwq_data_2020_current$EC_surface == "935 μs/cm"] <- 0.935
#TOTAL DISSOLVED SOLIDS (TDS)
#fixing the cells in g/L to ppt (parts per thousand), its a simple 1:1 conversion so no biggie
mwq_data_2020_current$TDS_surface[mwq_data_2020_current$TDS_surface == "3.101 g/L"] <- 3.101
mwq_data_2020_current$TDS_surface[mwq_data_2020_current$TDS_surface == "7.65 g/L"] <- 7.65
mwq_data_2020_current$TDS_surface[mwq_data_2020_current$TDS_surface == "19.14 g/L"] <- 19.14
mwq_data_2020_current$TDS_surface[mwq_data_2020_current$TDS_surface == "11.75 g/L"] <- 11.75
#SALINITY
#wtf does over mean? making it say NA
mwq_data_2020_current$salinity_surface[mwq_data_2020_current$salinity_surface == "Over"] <- NA
mwq_data_2020_current<-
mwq_data_2020_current |>
mutate(
sampling_location = case_match(
sampling_location,
"Middle Marsh" ~ "mid_marsh",
"Middle marsh" ~ "mid_marsh",
"Middle Marsh\n" ~ "mid_marsh",
"Hoag" ~ "hoag_pond",
"Hoag Pond" ~ "hoag_pond",
"Upper marsh" ~ "upper_marsh",
"Upper Marsh" ~ "upper_marsh",
"Pond 10" ~ "pond_10",
"Pond 11" ~ "pond_11",
"pond 11" ~ "pond_11",
"Pond 5" ~ "pond_5",
"Pond 3" ~ "pond_3",
"Pond 8" ~ "pond_8",
"Intake at Campus Dr" ~ "intake_campus_dr",
"Lower marsh" ~ "lower_marsh",
"Lower Marsh" ~ "lower_marsh",
"Lower Marsh\n" ~ "lower_marsh",
"Upper SD creek" ~ "upper_SDC",
"Lower SD creek" ~ "low_SDC",
"Middle SD creek" ~ "mid_SDC",
"Middle SD creek\n" ~ "mid_SDC",
"Intake" ~ "intake_SDC",
"SDC Intake" ~ "intake_SDC",
.default = sampling_location))
mwq_data_2020_current |>
count(sampling_location) |>
print(n = Inf)
unique(mwq_data_2020_current$sampling_location)
#combine date and time columns?
mwq_cleandata<-
mwq_data_2020_current |>
unite("datetime", date, time, sep = " ", remove = FALSE) |>
mutate(datetime = ymd_hms(datetime))
#selecting only relevant columns, don't need any deep data since they only collected this data for a short period of time and then stopped taking it, they believed that the ponds at the SJM are not actually deep enough to have a significant difference in these measurements at the bottom of the ponds compared to the middle of the water column, drop pH since unreliable??
mwq_cleaner_data<-
mwq_cleandata |>
select(sampling_location, datetime, collection_method, dawn_dusk, weather, tide, staff_gauge_ft, surface_temp, EC_surface, TDS_surface, salinity_surface, pH, notes, DO_surface)
#making sure its all being read correctly
mwq_cleaner_data<-
mwq_cleaner_data |>
mutate(staff_gauge_ft = as.numeric(staff_gauge_ft),
surface_temp = as.numeric(surface_temp),
DO_surface= as.numeric(DO_surface),
EC_surface = as.numeric(EC_surface),
TDS_surface = as.numeric(TDS_surface),
salinity_surface = as.numeric(salinity_surface),
pH = as.numeric(pH)
)
#sampling location
mwq_cleaner_data
# 1. Install and load the package (only need to install once)
#library(writexl)
# 2. Export your dataset
# Replace 'my_data' with your dataframe, and name your file
#write_xlsx(mwq_cleaner_data, "mwq_cleaner_data.xlsx")
#separate data by dawn dusk samples vs non dawn dusk samples, Julie said that the dawn dusk samples would show differences with non samples because temps would be lower since the samples were taken earlier in the day vs non samples that were mostly samples in the afternoon, Julie also wants to see if time/seasonality are factors
#dis da dawn dusk data
mwq_dd_data<-
mwq_cleaner_data |>
filter(dawn_dusk == "Y")
#dis da non dawn dusk data
mwq_nondd_data<-
mwq_cleaner_data |>
filter( ! dawn_dusk == "Y")
#create date pairings, some do no ot have a pair but I dont want to drop that data since it could be helpful later
date_pairs<-
mwq_dd_data |>
mutate(date=as.Date(datetime)) |>
distinct(sampling_location, date) |>
filter(!is.na(date)) |>
arrange(sampling_location, date) |>
group_by(sampling_location) |>
mutate( new_run = is.na(lag(date)) | (date - lag(date) != 1), run_id = cumsum(new_run) ) |>
group_by(sampling_location, run_id) |>
mutate(pair_in_run = (row_number() - 1) %/% 2 + 1) |>
group_by(sampling_location) |>
mutate( pairsamp_id = cumsum( row_number() == 1 | run_id != lag(run_id) | pair_in_run != lag(pair_in_run) ) ) |>
ungroup() |>
select(sampling_location, date, pairsamp_id)
#averages of the two days sampled
dd_pairsamp_avg_all<-
mwq_dd_data |>
mutate(date = as.Date(datetime)) |>
filter(!is.na(date)) |>
left_join( date_pairs, by = c("sampling_location", "date") ) |>
group_by(sampling_location, pairsamp_id) |>
summarise(
start_date = min(date),
end_date = max(date),
n_days = n_distinct(date),
mean_EC = mean(EC_surface, na.rm = TRUE),
mean_TDS = mean(TDS_surface, na.rm = TRUE),
mean_temp = mean(surface_temp, na.rm = TRUE),
mean_salinity = mean(salinity_surface, na.rm = TRUE),
mean_pH = mean(pH, na.rm = TRUE),
mean_DO = mean(DO_surface, na.rm = TRUE),
.groups = "drop" ) |>
mutate(
month = month(start_date),
season = case_when(
month %in% c(12, 1, 2) ~ "Winter",
month %in% c(3, 4, 5)  ~ "Spring",
month %in% c(6, 7, 8)  ~ "Summer",
month %in% c(9, 10, 11) ~ "Fall"),
year = year(start_date))
dd_pairsamp_avg_all
#dd_pairsamp_avg_all |>
# Plot scatter points and a line graph faceted by year
ggplot(dd_pairsamp_avg_all, aes(x = year, y = mean_EC)) +
geom_point(color = "blue", alpha = 0.6) +   # Adds the scatter plot
geom_line(color = "darkred", size = 1) +     # Adds the line graph
labs(
title = "Marsh EC over time",
x = "Year",
y = "EC"
) +
theme_minimal()+
facet_wrap(~sampling_location)
#horrible graph, actually awful
#bar graph?
ggplot(dd_pairsamp_avg_all, aes(x = year, y = mean_EC)) +
geom_col( color = "darkgray", linewidth = 1)+
facet_wrap(~sampling_location)
#okay i see that there needs to be a curved line maybe, could do a geom col with, also i need to label season to it, could do the averages of the month, also possibly year too
EC_dd_avgs <- ggplot(dd_pairsamp_avg_all, aes(x = start_date)) +
geom_smooth(
aes(y = mean_EC),
method = "loess",
linewidth = 0.5,
alpha = 0.8
) +
labs(
x = "Date",
y = "Conductivity mS",
title = "Average Yearly Conductivity of Dawn/Dusk/Dawn Sampled Ponds in San Joaquin Marsh"
) +
scale_x_date(
date_labels = "%Y",
date_breaks = "1 year",
expand = c(0, 0)
) +
theme_bw() +
theme(
legend.position = "right",
plot.title = element_text(hjust = 0.5),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.title.y = element_text(size = 10.5),
text = element_text(family = "Helvetica")
) +
facet_wrap(~sampling_location)
#this does not look right ??? looking at salinity next
plot(EC_dd_avgs)
sal_dd_avgs <- ggplot(dd_pairsamp_avg_all, aes(x = year)) +
geom_line(
aes(y = mean_salinity),
method = "loess",
linewidth = 0.5,
alpha = 0.8
) +
labs(
x = "Year",
y = "Salinity ppt",
title = "Average Salinity  of Dawn/Dusk/Dawn Sampled Ponds in San Joaquin Marsh"
) +
scale_x_date(
date_labels = "%Y",
date_breaks = "1 year",
expand = c(0, 0)
) +
theme_bw() +
theme(
legend.position = "right",
plot.title = element_text(hjust = 0.5),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.title.y = element_text(size = 10.5),
text = element_text(family = "Helvetica")
) +
facet_wrap(~sampling_location)
print(sal_dd_avgs)
