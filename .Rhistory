pairsamp_dd_raw<-
mwq_dd_data |>
mutate(date = as.Date(datetime)) |>
filter(!is.na(date)) |>
left_join( date_pairs, by = c("sampling_location", "date") ) |>
group_by(sampling_location, pairsamp_id) |>
mutate(
month = month(date),
season = case_when(
month %in% c(12, 1, 2) ~ "Winter",
month %in% c(3, 4, 5)  ~ "Spring",
month %in% c(6, 7, 8)  ~ "Summer",
month %in% c(9, 10, 11) ~ "Fall"),
year = year(date))
#Calculate the average per season
dd_seasonalavg_all <-
pairsamp_dd_raw |>
group_by(sampling_location,year, season) |>
summarise(
seas_mean_EC = mean(EC_surface, na.rm = TRUE),
seas_mean_TDS = mean(TDS_surface, na.rm = TRUE),
seas_mean_temp = mean(surface_temp, na.rm = TRUE),
seas_mean_salinity = mean(salinity_surface, na.rm = TRUE),
seas_mean_pH = mean(pH, na.rm = TRUE),
seas_mean_DO = mean(DO_surface, na.rm = TRUE),
.groups = "drop" )
#write_xlsx(dd_seasonalavg_all, "dd_seasonalavg_all.xlsx")
View(pairsamp_dd_raw)
# Combine season and year with a space separator
dd_syearavg_all <-
dd_seasonalavg_all |>
unite(col = "season_year", season, year, sep = " ")
# Plot scatter points and a line graph faceted by year
ggplot(dd_syearavg_all, aes(x = season_year, y = seas_mean_EC)) +
geom_point(color = "blue", alpha = 0.6) +   # Adds the scatter plot
geom_line(color = "darkred", size = 1) +     # Adds the line graph
labs(
title = "Marsh EC over time",
x = "Season and Year",
y = "EC"
) +
theme_minimal()+
facet_wrap(~sampling_location)
