#separate data by dawn dusk samples vs non dawn dusk samples, Julie said that the dawn dusk samples would show differences with non samples because temps would be lower since the samples were taken earlier in the day vs non samples that were mostly samples in the afternoon, Julie also wants to see if time/seasonality are factors
#dis da dawn dusk data
mwq_dd_data<-
mwq_cleaner_data |>
filter(dawn_dusk == "Y")
mwq_nondd_data<-
mwq_cleaner_data |>
filter( ! dawn_dusk == "Y")
#calculating day avgs of response variables of interest, fixed it from before
dd_dayavg_all <-
mwq_dd_data |>
group_by(sampling_location, date = as.Date(datetime)) |>
summarise(
dd_dayavg_EC = mean(EC_surface, na.rm = TRUE),
dd_dayavg_TDS = mean(TDS_surface, na.rm = TRUE),
dd_dayavg_temp = mean(surface_temp, na.rm = TRUE),
dd_dayavg_salinity = mean(salinity_surface, na.rm = TRUE),
dd_dayavg_pH = mean(pH, na.rm = TRUE),
dd_dayavg_DO = mean(DO_surface, na.rm = TRUE),
.groups = "drop")
write_xlsx(dd_dayavg_all, "dd_dayavg_all.xlsx")
View(dd_dayavg_all)
#Calculate the average per season
dd_seasonalavg_all <-
dd_seasons |>
group_by(sampling_location,year, season) |>
summarise(
dd_savg_EC = mean(dd_dayavg_EC, na.rm = TRUE),
dd_savg_TDS = mean(dd_dayavg_TDS, na.rm = TRUE),
dd_savg_temp = mean(dd_dayavg_temp, na.rm = TRUE),
dd_savg_salinity = mean(dd_dayavg_salinity, na.rm = TRUE),
dd_savg_pH = mean(dd_dayavg_pH, na.rm = TRUE),
dd_savg_DO = mean(dd_dayavg_DO, na.rm = TRUE),
.groups = "drop")
View(dd_dayavg_all)
#Adding a 'season' column based on month
dd_seasons <-
dd_dayavg_all |>
mutate(
month = month(date),
season = case_when(
month %in% c(12, 1, 2) ~ "Winter",
month %in% c(3, 4, 5)  ~ "Spring",
month %in% c(6, 7, 8)  ~ "Summer",
month %in% c(9, 10, 11) ~ "Fall"
),
year = year(date)
)
#Calculate the average per season
dd_seasonalavg_all <-
dd_seasons |>
group_by(sampling_location,year, season) |>
summarise(
dd_savg_EC = mean(dd_dayavg_EC, na.rm = TRUE),
dd_savg_TDS = mean(dd_dayavg_TDS, na.rm = TRUE),
dd_savg_temp = mean(dd_dayavg_temp, na.rm = TRUE),
dd_savg_salinity = mean(dd_dayavg_salinity, na.rm = TRUE),
dd_savg_pH = mean(dd_dayavg_pH, na.rm = TRUE),
dd_savg_DO = mean(dd_dayavg_DO, na.rm = TRUE),
.groups = "drop")
