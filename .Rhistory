dd_seasonalavg_all <-
pairsamp_dd_raw |>
group_by(sampling_location,year, season) |>
summarise(
seas_mean_EC = mean(EC_surface, na.rm = TRUE),
seas_mean_TDS = mean(TDS_surface, na.rm = TRUE),
seas_mean_temp = mean(surface_temp, na.rm = TRUE),
seas_mean_salinity = mean(salinity_surface, na.rm = TRUE),
seas_mean_pH = mean(pH, na.rm = TRUE),
seas_mean_DO = mean(DO_surface, na.rm = TRUE),
.groups = "drop" )
View(dd_seasonalavg_all)
# Combine season and year with a space separator
dd_syearavg_all <-
dd_seasonalavg_all |>
unite(col = "season_year", season, year, sep = " ")
View(dd_syearavg_all)
