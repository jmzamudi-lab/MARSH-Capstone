#rename the columns
mwq_data_2020_current<-
mwq_data_2020_current |>
dplyr::rename( Sampling_location = "Refer to map for pond #s, marsh units",
Date = "mm/dd/yyyy",
Time = "24hr",
Collection_method = "How was sample taken? Wading, kayak, etc.",
Recorder = "Who sampled?",
Dawn_Dusk = "Y/N",
Weather = "Temp, conditions",
Tide = "High/Med/Low",
Staff_Gauge_ft = "ft, gradations in 10ths",
Depth_ft =  "ft, gradations of inches",
pH = "...11",
Surface_temp = "degrees C...12",
EC_surface = "mS...13",
TDS_surface = "ppt...14",
Salinity_surface = "ppt...15",
DO_surface = "mg/L...16",
DO_temp = "degrees C...17",
Temp_deep = "degrees C...18",
EC_deep = "mS...19",
TDS_deep = "ppt...20",
Salinity_deep = "ppt...21",
pH_deep = "...22",
DO_deep = "mg/L...23",
Notes = "anything that might affect water quality-inverts, algae, temp, weather, etc"
)
