# dailyavg_TDS = mean(TDS_surface, na.rm = TRUE),
#dailyavg_temp = mean(Surface_temp, na.rm = TRUE),
#dailyavg_salinity = mean(Salinity_surface, na.rm = TRUE),
#dailyavg_pH = mean(pH, na.rm = TRUE))
# Step 3: Group by location to get the overall average per day/location
#avgEC_location <- avgEC |>
#group_by(Sampling_location)|>
#summarise(avgEC_per_day = mean(dailyavg_EC, na.rm = TRUE))
#print(dailyavg_summary)
#separate data by dawn dusk samples vs non dawn dusk samples, Julie said that the dawn dusk samples would show differences with non samples because temps would be lower since the samples were taken earlier in the day vs non samples that were mostly samples in the afternoon, Julie also wants to see if time/seasonality are factors
#dis da dawn dusk data
mwq_dd_data<-
mwq_cleaner_data |>
filter(dawn_dusk == "Y")
#dis da non dawn dusk data
mwq_nondd_data<-
mwq_cleaner_data |>
filter( ! dawn_dusk == "Y")
#calculating day avgs of response variables of interest
dd_dayavg_all <-
mwq_dd_data |>
group_by(sampling_location, datetime) |>
summarise(
dd_dayavg_EC = mean(EC_surface, na.rm = TRUE),
dd_dayavg_TDS = mean(TDS_surface, na.rm = TRUE),
dd_dayavg_temp = mean(surface_temp, na.rm = TRUE),
dd_dayavg_salinity = mean(salinity_surface, na.rm = TRUE),
dd_dayavg_pH = mean(pH, na.rm = TRUE))
EC_dd_avgs <- ggplot(dd_dayavg_all, aes(x = datetime)) +
geom_smooth(
aes(y = dd_dayavg_EC),
linewidth = 0.5,
alpha = 0.8
) +
labs(
x = "Date",
y = "Conductivity mS",
title = "Average Yearly Conductivity of Dawn/Dusk/Dawn Sampled Ponds in San Joaquin Marsh"
) +
scale_x_date(
date_labels = "%y",
date_breaks = "1 year",
expand = c(0, 0)
) +
theme_bw() +
theme(
legend.position = "right",
plot.title = element_text(hjust = 0.5),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.title.y = element_text(size = 10.5),
text = element_text(family = "Helvetica")
) +
facet_wrap(~sampling_location)
plot(EC_dd_avgs)
View(dd_dayavg_all)
