theme_bw() +
theme(
legend.position = "right",
plot.title = element_text(hjust = 0.5),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.title.y = element_text(size = 10.5),
text = element_text(family = "Helvetica")
) +
facet_wrap(~season)
#bar graph?
ggplot(dd_pairsamp_avg_all, aes(x = year, y = mean_TDS)) +
geom_col( aes(fill = sampling_location))+
geom_hline(yintercept=1,colour="red")+ #freshwater line
facet_wrap(~sampling_location)
#mean EC: plot scatter points and a line graph
ggplot(dd_pairsamp_avg_all, aes(x = year, y = mean_EC))+
geom_hline(yintercept=1.5,colour="red")+ #freshwater line
geom_point(aes(color = sampling_location))+
geom_line(aes(color = sampling_location)) +
labs(
title = "Mean Electrical Conductivity of Dawn/Dusk/Dawn Sampled Ponds in San Joaquin Marsh",
x = "Year",
y = "Electrical Conductivity mS")
